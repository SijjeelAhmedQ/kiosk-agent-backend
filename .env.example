# ---- The brain ---------------------------------------------------------
# There are two ways to choose one, and the first one wins.
#
# 1. The LLM Configuration screen in the control panel (/llm.html). What it
#    saves lands in var/llm-config.json, and *every* agent on this floor reads
#    it — the ordering agent, both A2A agents and the Foodpanda dispatcher —
#    so one choice there switches all of them, with no restart. That file is
#    the source of truth once it exists. LLM_CONFIG_PATH moves it, which is
#    only worth doing if two checkouts share one machine.
#
# 2. Everything below, which is what a deployment runs on until somebody makes
#    that choice. Unchanged, and still the way to configure a machine that has
#    no browser pointed at it.
#
# anthropic | gemini | openai | groq | huggingface | openrouter | ollama. Strands is
# model-agnostic, so this is the only line that changes — the tools, the prompt
# and the wallet are untouched.
# Leave AGENT_MODEL blank to get a sensible default for whichever you pick.
AGENT_PROVIDER=anthropic

# --- anthropic: best tool-calling, paid ---------------------------------
# The agent needs its own key — it does not share your Claude Code session.
# Get one at https://console.anthropic.com/settings/keys, and note that a
# Claude Pro/Max subscription does NOT include API credits — top up separately.
ANTHROPIC_API_KEY=

# --- gemini: has a free tier, no card required (best free option) --------
# Get a key at https://aistudio.google.com/apikey
# Default model: gemini-2.5-flash
GOOGLE_API_KEY=

# --- openai: paid, strong tool-calling -----------------------------------
# Get a key at https://platform.openai.com/api-keys — an OpenAI *account* has
# no credit by default, so add billing separately or calls 429.
# Default model: gpt-5. AGENT_EFFORT is ignored on this provider.
OPENAI_API_KEY=

# --- groq: free tier, no card, very fast ---------------------------------
# Get a key at https://console.groq.com/keys. Groq serves open-weight models on
# its own hardware over an OpenAI-compatible endpoint.
# Default model: openai/gpt-oss-120b. AGENT_EFFORT is ignored here.
# Two free-tier gotchas, both worth knowing before you change AGENT_MODEL:
#   - The ceiling is tokens *per minute*, and Groq charges the reserved output
#     against it too, so prompt + AGENT_MAX_TOKENS must fit under the model's
#     TPM (8k here) or the call is a 413 no retry will fix. Use ~1500.
#   - Not every model on Groq calls tools properly. llama-3.3-70b-versatile has
#     more TPM but intermittently writes `<function=name{args}>` as text, which
#     comes back as "tool call validation failed" and ends the run.
GROQ_API_KEY=

# --- huggingface: free monthly credits, no card --------------------------
# Get a token at https://huggingface.co/settings/tokens — a fine-grained token
# needs the "Make calls to Inference Providers" permission ticked, or every
# call comes back 401. HF's router fronts several vendors' hardware behind one
# OpenAI-compatible endpoint, so the model ids are the Hub's own (org/model).
# Default model: openai/gpt-oss-120b. AGENT_EFFORT is ignored here.
#   - The router picks a backend per call. Pin one by appending it to the id:
#     openai/gpt-oss-120b:groq, :together, :fireworks.
#   - The free tier meters monthly credits rather than tokens per minute, so
#     AGENT_MAX_TOKENS does not need groq's ~1500 workaround. It does run out —
#     when it does, calls 402 rather than 429.
HF_TOKEN=

# --- openrouter: one key for every vendor, pay-as-you-go + free tier -----
# Get a key at https://openrouter.ai/keys. OpenRouter fronts Anthropic, OpenAI,
# Google and the open-weight models behind a single OpenAI-compatible endpoint,
# so the model ids are `org/model` and one key reaches all of them — which is
# why it suits the two A2A agents, who would otherwise need two accounts.
# Default model: openai/gpt-oss-120b. AGENT_EFFORT is ignored here.
#   - Append `:free` to an id (openai/gpt-oss-120b:free) for free-tier routing,
#     which is rate-limited per day rather than metered.
#   - It routes a given id to whichever upstream is available, so like the HF
#     router it can behave slightly differently call to call.
OPENROUTER_API_KEY=

# --- ollama: fully local, free, no key, works offline --------------------
# Install from https://ollama.com, then: ollama pull qwen3:8b
# Default model: qwen3:8b. Weaker at multi-step tool use than the hosted
# models — expect to retry a run.
OLLAMA_HOST=http://localhost:11434

# Blank = the default for the chosen provider. On anthropic, claude-sonnet-5
# is a cheaper alternative to the claude-opus-5 default.
AGENT_MODEL=
AGENT_MAX_TOKENS=8000

# low | medium | high | xhigh | max — how hard the model thinks per step.
# Anthropic only; ignored by the other providers (including openai).
AGENT_EFFORT=high

# ---- The restaurant ----------------------------------------------------
FK_API_BASE=http://localhost:8000/api/v1
FK_WEB_BASE=http://localhost:5173

# Recorded on the order and the coupon ledger, so agent orders are tellable
# apart from walk-in ones in the admin screens.
FK_TERMINAL_ID=agent-01

FK_HTTP_TIMEOUT=20

# ---- The branches ------------------------------------------------------
# Where the restaurant has counters, as JSON. This is what turns a customer's
# coordinates into a place a courier can collect from — the Friends Kitchen API
# has no branch concept of its own, so the directory lives here.
#
# Blank means the one branch the code falls back to — Saddar, Rawalpindi, see
# agent/branches.py — which is exactly what the API already assumes. Set it only
# when there is more than one counter, or the pickup changes street.
#
#   FK_BRANCHES=[{"id":"fk-saddar","name":"Friends Kitchen Saddar","address":"Friends Kitchen, Saddar, Rawalpindi","latitude":33.598827,"longitude":73.053810,"phone":"+92..."},{"id":"fk-westridge","name":"Friends Kitchen Westridge","address":"Westridge, Rawalpindi","latitude":33.5875,"longitude":72.9950}]
#
# A branch missing latitude/longitude is dropped rather than guessed at.
FK_BRANCHES=

# ---- The customer's own address -----------------------------------------
# Where "deliver it to me" means. Two flows need this because neither has a
# browser to ask: the A2A negotiation on 8101, which is two agents talking on a
# port, and the errand console, which offers it as one click instead of a
# geolocation prompt. An errand that carries its own fix uses that one — this is
# the fallback, never an override.
#
# The address is what the rider reads and what the delivery board shows. The
# coordinates decide which branch collects and how far the ride is quoted at, so
# set them properly before pointing this at a courier that charges by the
# kilometre — a plausible-looking pair a few kilometres out is worse than an
# obviously wrong one, because nothing about it looks wrong.
FK_CUSTOMER_ADDRESS=Shabbir Lane, Street No 6 East, opposite Malik Car Parking, Westridge, Rawalpindi
FK_CUSTOMER_LAT=33.5875
FK_CUSTOMER_LON=72.9950

# ---- Delivery ----------------------------------------------------------
# Who carries a paid order to the customer: internal | mock_foodpanda | foodpanda.
#
# The handover only happens when an errand is started with a customer location
# (`userLocation` on POST /api/agent/runs). Without one the agent places the
# counter order it always has, and nothing in this section is consulted.
DELIVERY_PROVIDER=internal

# --- internal: Friends Kitchen's own delivery agent, no credentials ------
# A separate service with its own agent card, the way the A2A merchant on 8101
# is separate from the errand server on 8100:
#   .venv\Scripts\python -m uvicorn delivery_server:app --port 8102
# The ordering agent reaches it over real HTTP, which is what makes the
# handover agent-to-agent rather than a function call. It dispatches to a
# simulated courier — honest about the outcome, but not driving a vehicle.
DELIVERY_BASE_URL=http://localhost:8102

# --- mock_foodpanda: the Foodpanda dispatcher agent, no credentials ------
# A second AI agent, on its own port, with its own console at /foodpanda.html:
#   .venv\Scripts\python -m uvicorn foodpanda_server:app --port 8103
# Unlike the in-house courier above — a state machine on a clock — this one has
# a brain. It reads the delivery request, decides whether the drop is inside its
# service radius, refuses it if not, and otherwise assigns a rider and runs the
# job leg by leg. The ride is compressed to seconds and awaited, never skipped,
# and it is not connected to Foodpanda in any way. That is what `mock` means
# here, and it is said on the agent card, in the display name and in the console.
MOCK_FOODPANDA_BASE_URL=http://localhost:8103

# Its brain. Blank means "whatever AGENT_PROVIDER is", so an .env that already
# runs the ordering agent runs this one too. Give it a different provider if you
# are on a free tier — two agents sharing one rate limit means the delivery half
# of the errand dies while the order sits paid.
MOCK_FOODPANDA_PROVIDER=
MOCK_FOODPANDA_MODEL=
MOCK_FOODPANDA_MAX_TOKENS=32000
MOCK_FOODPANDA_EFFORT=medium

# The ride, in seconds per leg, and the radius the dispatcher refuses beyond.
# Short enough to watch happen in a demo; the statuses are the ones a real
# courier reports, in the order a real one reports them.
MOCK_FOODPANDA_PICKUP_SECONDS=8
MOCK_FOODPANDA_TRANSIT_SECONDS=12
MOCK_FOODPANDA_RADIUS_KM=25

# What the ride costs, in rupees: base + per_km × straight-line distance.
MOCK_FOODPANDA_FEE_BASE=120
MOCK_FOODPANDA_FEE_PER_KM=35

# Whether the two steps a customer can see wait to be asked for. On — the
# default — the dispatcher judges the job and then holds: once at `accepted`,
# until somebody on the board presses "Find a rider", and again once the order is
# collected, until they press "Deliver it to me". That is what a dispatch desk
# looks like, and it is what makes /foodpanda.html a control rather than a
# progress bar.
#
# Set it to false for an unattended demo and a job runs start to finish the
# moment it lands. Nothing about the agent's decisions changes either way: the
# gates cannot move a job anywhere its lifecycle forbids, and the ordering agent
# on the other side of the wire reads a waiting job as still on its way, which is
# what it is.
MOCK_FOODPANDA_MANUAL_STEPS=true

# How long a gated step waits before the dispatcher gives up on it. A job nobody
# ever attends to must not hold a rider and an open stream for the life of the
# process — it fails, and says that nobody answered.
MOCK_FOODPANDA_OPERATOR_TIMEOUT_SECONDS=900

# --- foodpanda: a real courier API --------------------------------------
# Both must be set or the provider reports itself unconfigured and the registry
# falls back to the in-house courier. There is deliberately no mock success
# path here: a provider that fakes a dispatch reports food delivered that no
# rider ever collected.
#
# The key is read on this server and put on an outgoing header. It is never
# returned by a tool and never reaches the browser — the health endpoint says
# only whether one is present.
FOODPANDA_API_BASE=
FOODPANDA_API_KEY=

# Couriers answer slower than the restaurant does, and a dispatch that times
# out leaves an order paid but unassigned — so it gets its own budget.
DELIVERY_TIMEOUT=15

# ---- Tracing (OpenTelemetry) -------------------------------------------
# Off by default, and that is the right default: a demo should not need a
# collector running, and a tracer nobody reads is overhead with no reader.
#
# What it buys is the one thing four separate processes cost you. An errand
# crosses the buyer, the merchant, the restaurant and a courier, and no single
# console shows all of it. With this on, every hop carries a `traceparent`
# header and one errand becomes one tree — the agent loop, each model call with
# its token counts, each tool call, each HTTP hop, and the waits.
#
#   off      nothing is traced. The default.
#   console  spans are printed to this process's stdout. For checking the
#            wiring before you check the collector.
#   otlp     spans go to OTEL_EXPORTER_OTLP_ENDPOINT below.
#   both     both of the above.
FK_OTEL=off

# Where OTLP spans go. The HTTP exporter appends /v1/traces itself, so this is
# the collector root — which is what Jaeger, Tempo, the OTel Collector and
# Langfuse all document. Left blank it defaults to http://localhost:4318.
#
# A quick local collector with a UI, if you have Docker:
#   docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one
# then open http://localhost:16686 and pick a friends-kitchen-* service.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Auth for a hosted collector, as comma-separated key=value pairs — for example
# `Authorization=Bearer abc123`. Read by the OTel SDK itself and never reported:
# the health endpoint says whether headers are set, never what is in them.
OTEL_EXPORTER_OTLP_HEADERS=

# What the four services call themselves in the traces. Each process appends
# its own role — friends-kitchen-ordering-agent, -a2a-desk, -courier,
# -foodpanda-dispatcher — so one variable renames the whole fleet.
#
# Note what is NOT used here: OTEL_SERVICE_NAME. One .env configures all four
# services in this repo, so a name set there would label the courier's spans as
# the ordering agent's. Each process names itself instead.
FK_OTEL_SERVICE_PREFIX=friends-kitchen
