# ---- The brain ---------------------------------------------------------
# anthropic | gemini | openai | groq | huggingface | openrouter | ollama. Strands is
# model-agnostic, so this is the only line that changes — the tools, the prompt
# and the wallet are untouched.
# Leave AGENT_MODEL blank to get a sensible default for whichever you pick.
AGENT_PROVIDER=anthropic

# --- anthropic: best tool-calling, paid ---------------------------------
# The agent needs its own key — it does not share your Claude Code session.
# Get one at https://console.anthropic.com/settings/keys, and note that a
# Claude Pro/Max subscription does NOT include API credits — top up separately.
ANTHROPIC_API_KEY=

# --- gemini: has a free tier, no card required (best free option) --------
# Get a key at https://aistudio.google.com/apikey
# Default model: gemini-2.5-flash
GOOGLE_API_KEY=

# --- openai: paid, strong tool-calling -----------------------------------
# Get a key at https://platform.openai.com/api-keys — an OpenAI *account* has
# no credit by default, so add billing separately or calls 429.
# Default model: gpt-5. AGENT_EFFORT is ignored on this provider.
OPENAI_API_KEY=

# --- groq: free tier, no card, very fast ---------------------------------
# Get a key at https://console.groq.com/keys. Groq serves open-weight models on
# its own hardware over an OpenAI-compatible endpoint.
# Default model: openai/gpt-oss-120b. AGENT_EFFORT is ignored here.
# Two free-tier gotchas, both worth knowing before you change AGENT_MODEL:
#   - The ceiling is tokens *per minute*, and Groq charges the reserved output
#     against it too, so prompt + AGENT_MAX_TOKENS must fit under the model's
#     TPM (8k here) or the call is a 413 no retry will fix. Use ~1500.
#   - Not every model on Groq calls tools properly. llama-3.3-70b-versatile has
#     more TPM but intermittently writes `<function=name{args}>` as text, which
#     comes back as "tool call validation failed" and ends the run.
GROQ_API_KEY=

# --- huggingface: free monthly credits, no card --------------------------
# Get a token at https://huggingface.co/settings/tokens — a fine-grained token
# needs the "Make calls to Inference Providers" permission ticked, or every
# call comes back 401. HF's router fronts several vendors' hardware behind one
# OpenAI-compatible endpoint, so the model ids are the Hub's own (org/model).
# Default model: openai/gpt-oss-120b. AGENT_EFFORT is ignored here.
#   - The router picks a backend per call. Pin one by appending it to the id:
#     openai/gpt-oss-120b:groq, :together, :fireworks.
#   - The free tier meters monthly credits rather than tokens per minute, so
#     AGENT_MAX_TOKENS does not need groq's ~1500 workaround. It does run out —
#     when it does, calls 402 rather than 429.
HF_TOKEN=

# --- openrouter: one key for every vendor, pay-as-you-go + free tier -----
# Get a key at https://openrouter.ai/keys. OpenRouter fronts Anthropic, OpenAI,
# Google and the open-weight models behind a single OpenAI-compatible endpoint,
# so the model ids are `org/model` and one key reaches all of them — which is
# why it suits the two A2A agents, who would otherwise need two accounts.
# Default model: openai/gpt-oss-120b. AGENT_EFFORT is ignored here.
#   - Append `:free` to an id (openai/gpt-oss-120b:free) for free-tier routing,
#     which is rate-limited per day rather than metered.
#   - It routes a given id to whichever upstream is available, so like the HF
#     router it can behave slightly differently call to call.
OPENROUTER_API_KEY=

# --- ollama: fully local, free, no key, works offline --------------------
# Install from https://ollama.com, then: ollama pull qwen3:8b
# Default model: qwen3:8b. Weaker at multi-step tool use than the hosted
# models — expect to retry a run.
OLLAMA_HOST=http://localhost:11434

# Blank = the default for the chosen provider. On anthropic, claude-sonnet-5
# is a cheaper alternative to the claude-opus-5 default.
AGENT_MODEL=
AGENT_MAX_TOKENS=8000

# low | medium | high | xhigh | max — how hard the model thinks per step.
# Anthropic only; ignored by the other providers (including openai).
AGENT_EFFORT=high

# ---- The restaurant ----------------------------------------------------
FK_API_BASE=http://localhost:8000/api/v1
FK_WEB_BASE=http://localhost:5173

# Recorded on the order and the coupon ledger, so agent orders are tellable
# apart from walk-in ones in the admin screens.
FK_TERMINAL_ID=agent-01

FK_HTTP_TIMEOUT=20

# ---- The branches ------------------------------------------------------
# Where the restaurant has counters, as JSON. This is what turns a customer's
# coordinates into a place a courier can collect from — the Friends Kitchen API
# has no branch concept of its own, so the directory lives here.
#
# Blank means one branch (placeholder coordinates in Karachi), which is exactly
# what the API already assumes. Set it before pointing this at a real courier,
# or every pickup is dispatched to the wrong address.
#
#   FK_BRANCHES=[{"id":"fk-clifton","name":"Friends Kitchen Clifton","address":"Block 4, Clifton, Karachi","latitude":24.8138,"longitude":67.0300,"phone":"+92..."},{"id":"fk-gulshan","name":"Friends Kitchen Gulshan","address":"Gulshan-e-Iqbal, Karachi","latitude":24.9200,"longitude":67.0900}]
#
# A branch missing latitude/longitude is dropped rather than guessed at.
FK_BRANCHES=

# ---- Delivery ----------------------------------------------------------
# Who carries a paid order to the customer: internal | foodpanda.
#
# The handover only happens when an errand is started with a customer location
# (`userLocation` on POST /api/agent/runs). Without one the agent places the
# counter order it always has, and nothing in this section is consulted.
DELIVERY_PROVIDER=internal

# --- internal: Friends Kitchen's own delivery agent, no credentials ------
# A separate service with its own agent card, the way the A2A merchant on 8101
# is separate from the errand server on 8100:
#   .venv\Scripts\python -m uvicorn delivery_server:app --port 8102
# The ordering agent reaches it over real HTTP, which is what makes the
# handover agent-to-agent rather than a function call. It dispatches to a
# simulated courier — honest about the outcome, but not driving a vehicle.
DELIVERY_BASE_URL=http://localhost:8102

# --- foodpanda: a real courier API --------------------------------------
# Both must be set or the provider reports itself unconfigured and the registry
# falls back to the in-house courier. There is deliberately no mock success
# path here: a provider that fakes a dispatch reports food delivered that no
# rider ever collected.
#
# The key is read on this server and put on an outgoing header. It is never
# returned by a tool and never reaches the browser — the health endpoint says
# only whether one is present.
FOODPANDA_API_BASE=
FOODPANDA_API_KEY=

# Couriers answer slower than the restaurant does, and a dispatch that times
# out leaves an order paid but unassigned — so it gets its own budget.
DELIVERY_TIMEOUT=15
